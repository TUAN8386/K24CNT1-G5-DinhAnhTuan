@model HangSanXuat
@{
    ViewData["Title"] = "Thêm hãng";
}
<h1 class="h4 mb-3">Thêm hãng sản xuất</h1>
<form asp-action="Create" method="post" enctype="multipart/form-data" class="box" style="max-width:600px">
    <partial name="_Form" model="Model" />
    <button class="btn btn-accent" type="submit">Lưu</button>
    <a asp-action="Index" class="btn btn-link">Quay lại</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
