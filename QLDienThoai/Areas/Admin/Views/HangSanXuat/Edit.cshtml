@model HangSanXuat
@{
    ViewData["Title"] = "Sửa hãng";
}
<h1 class="h4 mb-3">Sửa hãng: @Model.TenHang</h1>
<form asp-action="Edit" asp-route-id="@Model.MaHang" method="post" enctype="multipart/form-data" class="box" style="max-width:600px">
    <partial name="_Form" model="Model" />
    <button class="btn btn-accent" type="submit">Lưu thay đổi</button>
    <a asp-action="Index" class="btn btn-link">Quay lại</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
