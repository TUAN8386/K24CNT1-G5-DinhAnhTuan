@model HangSanXuat
<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
<input type="hidden" asp-for="MaHang" />
<div class="mb-3">
    <label asp-for="TenHang" class="form-label"></label>
    <input asp-for="TenHang" class="form-control" />
    <span asp-validation-for="TenHang" class="text-danger small"></span>
</div>
<div class="mb-3">
    <label asp-for="QuocGia" class="form-label"></label>
    <input asp-for="QuocGia" class="form-control" />
    <span asp-validation-for="QuocGia" class="text-danger small"></span>
</div>
<div class="mb-3">
    <label class="form-label" for="fileLogo">Logo (jpg, png, webp – tối đa 5 MB)</label>
    <div class="mb-2"><img id="xemTruocLogo" src="@(Model.Logo ?? "/images/no-phone.svg")" class="img-preview" style="width:160px;height:64px" alt="Logo" /></div>
    <input type="file" name="fileLogo" id="fileLogo" class="form-control" accept=".jpg,.jpeg,.jfif,.png,.webp,.gif" data-preview="#xemTruocLogo" />
    <span class="text-danger small">@Html.ValidationMessage("fileLogo")</span>
</div>
