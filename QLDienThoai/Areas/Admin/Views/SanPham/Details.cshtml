@model SanPham
@{
    ViewData["Title"] = Model.TenSP;
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h4 mb-0">@Model.TenSP</h1>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.MaSP" class="btn btn-outline-primary btn-sm">Sửa</a>
        <a asp-area="" asp-controller="SanPham" asp-action="ChiTiet" asp-route-id="@Model.MaSP" target="_blank" class="btn btn-outline-secondary btn-sm">Xem trên cửa hàng</a>
    </div>
</div>
<div class="row g-4">
    <div class="col-md-4">
        <div class="box text-center">
            <img src="@(Model.AnhDaiDien ?? "/images/no-phone.svg")" class="img-fluid" alt="" />
            @if (Model.HinhAnhs.Any())
            {
                <div class="d-flex flex-wrap justify-content-center gap-2 mt-3">
                    @foreach (var h in Model.HinhAnhs.OrderBy(h => h.ThuTu))
                    {
                        <img src="@h.DuongDan" class="thumb" style="width:64px;height:64px;border:1px solid var(--line)" alt="" />
                    }
                </div>
            }
        </div>
    </div>
    <div class="col-md-8">
        <div class="box mb-3">
            <dl class="row mb-0">
                <dt class="col-sm-3">Hãng</dt><dd class="col-sm-9">@Model.HangSanXuat?.TenHang</dd>
                <dt class="col-sm-3">Màn hình</dt><dd class="col-sm-9">@Model.ManHinh</dd>
                <dt class="col-sm-3">Chip</dt><dd class="col-sm-9">@Model.Chip</dd>
                <dt class="col-sm-3">Camera</dt><dd class="col-sm-9">@Model.Camera</dd>
                <dt class="col-sm-3">Pin</dt><dd class="col-sm-9">@Model.Pin</dd>
                <dt class="col-sm-3">Hệ điều hành</dt><dd class="col-sm-9">@Model.HeDieuHanh</dd>
                <dt class="col-sm-3">Ngày tạo</dt><dd class="col-sm-9">@Model.NgayTao.ToString("dd/MM/yyyy")</dd>
            </dl>
        </div>
        <div class="box p-0">
            <div class="d-flex justify-content-between align-items-center p-3 pb-2">
                <strong>Phiên bản</strong>
                <a asp-controller="PhienBan" asp-action="Create" asp-route-maSP="@Model.MaSP" class="btn btn-sm btn-outline-success">Thêm phiên bản</a>
            </div>
            <table class="table table-sm mb-0">
                <thead class="table-light"><tr><th>Dung lượng</th><th>Màu</th><th class="text-end">Giá bán</th><th class="text-end">Tồn</th></tr></thead>
                <tbody>
                @foreach (var p in Model.PhienBans.OrderBy(p => p.GiaBan))
                {
                    <tr><td>@p.DungLuong</td><td>@p.MauSac</td><td class="text-end">@p.GiaBan.ToString("N0")</td><td class="text-end">@p.SoLuongTon</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
<h2 class="h6 fw-bold mt-4">Mô tả</h2>
<div class="box review-content">@Html.Raw(Model.MoTa)</div>
