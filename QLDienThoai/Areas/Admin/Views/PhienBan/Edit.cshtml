@model PhienBan
@{
    ViewData["Title"] = "Sửa phiên bản";
}
<h1 class="h4 mb-3">Sửa phiên bản #@Model.MaPB</h1>
<form asp-action="Edit" asp-route-id="@Model.MaPB" method="post" class="box" style="max-width:720px">
    <partial name="_Form" model="Model" />
    <div class="mt-3">
        <button class="btn btn-accent" type="submit">Lưu thay đổi</button>
        <a asp-action="Index" asp-route-maSP="@Model.MaSP" class="btn btn-link">Quay lại</a>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
