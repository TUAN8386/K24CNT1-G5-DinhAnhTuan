@model PagedResult<PhienBan>
@{
    ViewData["Title"] = "Phiên bản & tồn kho";
    var laAdmin = User.IsInRole(VaiTro.Admin);
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h4 mb-0">Phiên bản & tồn kho</h1>
    @if (laAdmin) { <a asp-action="Create" asp-route-maSP="@ViewBag.MaSPChon" class="btn btn-accent"><i class="bi bi-plus-lg"></i> Thêm phiên bản</a> }
</div>
<form method="get" class="row g-2 mb-3 align-items-center" style="max-width:820px">
    <div class="col-sm-4"><input name="q" value="@ViewBag.Q" class="form-control" placeholder="Tên máy, màu, dung lượng" aria-label="Tìm" /></div>
    <div class="col-sm-4">
        <select name="maSP" asp-items="ViewBag.MaSP" class="form-select" aria-label="Sản phẩm"><option value="">Tất cả sản phẩm</option></select>
    </div>
    <div class="col-sm-2 form-check ms-2">
        <input class="form-check-input" type="checkbox" name="sapHet" value="true" id="sapHet" checked="@(ViewBag.SapHet == true)" />
        <label class="form-check-label small" for="sapHet">Sắp hết (≤ 3)</label>
    </div>
    <div class="col-sm-1"><button class="btn btn-outline-secondary" type="submit">Lọc</button></div>
</form>
<div class="table-responsive">
    <table class="table table-hover align-middle table-admin">
        <thead class="table-light"><tr><th>Mã</th><th>Sản phẩm</th><th>Dung lượng</th><th>Màu sắc</th><th class="text-end">Giá bán</th><th class="text-end">Tồn kho</th><th class="text-end">Thao tác</th></tr></thead>
        <tbody>
        @foreach (var p in Model.Items)
        {
            <tr>
                <td>@p.MaPB</td>
                <td class="fw-semibold">@p.SanPham?.TenSP</td>
                <td>@p.DungLuong</td>
                <td>@p.MauSac</td>
                <td class="text-end">@p.GiaBan.ToString("N0")</td>
                <td class="text-end"><span class="badge @(p.SoLuongTon == 0 ? "text-bg-danger" : p.SoLuongTon <= 3 ? "text-bg-warning" : "text-bg-light")">@p.SoLuongTon</span></td>
                <td class="text-end text-nowrap">
                    <a asp-action="Details" asp-route-id="@p.MaPB" class="btn btn-sm btn-outline-secondary" title="Chi tiết"><i class="bi bi-eye"></i></a>
                    @if (laAdmin)
                    {
                        <a asp-action="NhapHang" asp-route-id="@p.MaPB" class="btn btn-sm btn-outline-success" title="Nhập hàng"><i class="bi bi-box-arrow-in-down"></i></a>
                        <a asp-action="Edit" asp-route-id="@p.MaPB" class="btn btn-sm btn-outline-primary" title="Sửa"><i class="bi bi-pencil"></i></a>
                        <a asp-action="Delete" asp-route-id="@p.MaPB" class="btn btn-sm btn-outline-danger" title="Xóa"><i class="bi bi-trash"></i></a>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
<partial name="_Pager" model="Model" />
