@model SuaDonVM
@{
    ViewData["Title"] = "Sửa đơn hàng";
}
<h1 class="h4 mb-3">Sửa thông tin đơn #@Model.MaDH</h1>
<form asp-action="Edit" asp-route-id="@Model.MaDH" method="post" class="box" style="max-width:720px">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <input type="hidden" asp-for="MaDH" />
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="HoTenNhan" class="form-label"></label>
            <input asp-for="HoTenNhan" class="form-control" />
            <span asp-validation-for="HoTenNhan" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="SoDienThoaiNhan" class="form-label"></label>
            <input asp-for="SoDienThoaiNhan" class="form-control" maxlength="10" />
            <span asp-validation-for="SoDienThoaiNhan" class="text-danger small"></span>
        </div>
        <div class="col-12">
            <label asp-for="DiaChiGiao" class="form-label"></label>
            <input asp-for="DiaChiGiao" class="form-control" />
            <span asp-validation-for="DiaChiGiao" class="text-danger small"></span>
        </div>
        <div class="col-12">
            <label asp-for="GhiChu" class="form-label"></label>
            <textarea asp-for="GhiChu" class="form-control" rows="2"></textarea>
        </div>
        <div class="col-12 form-check ms-2">
            <input asp-for="DaThanhToan" class="form-check-input" />
            <label asp-for="DaThanhToan" class="form-check-label"></label>
        </div>
    </div>
    <div class="mt-3">
        <button class="btn btn-accent" type="submit">Lưu</button>
        <a asp-action="Details" asp-route-id="@Model.MaDH" class="btn btn-link">Quay lại</a>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
