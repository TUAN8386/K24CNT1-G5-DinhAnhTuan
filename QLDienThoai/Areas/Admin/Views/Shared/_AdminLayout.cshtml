@{
    var c = ViewContext.RouteData.Values["controller"]?.ToString();
    var laAdmin = User.IsInRole(VaiTro.Admin);
    string Act(string ten) => c == ten ? "active" : "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản trị PhoneHub</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="admin">
<div class="d-flex admin-wrap">
    @* ===== Thanh menu trái "QUẢN TRỊ" (thu gọn thành offcanvas trên điện thoại) ===== *@
    <aside class="offcanvas-lg offcanvas-start admin-sidebar" tabindex="-1" id="adminMenu" aria-label="Menu quản trị">
        <div class="admin-brand d-flex justify-content-between align-items-center">
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">QUẢN TRỊ</a>
            <button type="button" class="btn-close btn-close-white d-lg-none" data-bs-dismiss="offcanvas" data-bs-target="#adminMenu" aria-label="Đóng"></button>
        </div>
        <nav class="nav flex-column w-100">
            <a class="nav-link @Act("Dashboard")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
            @if (laAdmin)
            {
                <a class="nav-link @Act("HangSanXuat")" asp-area="Admin" asp-controller="HangSanXuat" asp-action="Index">Hãng sản xuất</a>
                <a class="nav-link @Act("SanPham")" asp-area="Admin" asp-controller="SanPham" asp-action="Index">Sản phẩm</a>
            }
            <a class="nav-link @Act("PhienBan")" asp-area="Admin" asp-controller="PhienBan" asp-action="Index">Phiên bản &amp; tồn kho</a>
            <a class="nav-link @Act("DonHang")" asp-area="Admin" asp-controller="DonHang" asp-action="Index">Đơn hàng</a>
            @if (laAdmin)
            {
                <a class="nav-link @Act("TaiKhoan")" asp-area="Admin" asp-controller="TaiKhoan" asp-action="Index">Tài khoản</a>
                <a class="nav-link @Act("KhuyenMai")" asp-area="Admin" asp-controller="KhuyenMai" asp-action="Index">Khuyến mãi</a>
                <a class="nav-link @Act("ThongKe")" asp-area="Admin" asp-controller="ThongKe" asp-action="Index">Thống kê doanh thu</a>
            }
            <a class="nav-link" asp-area="" asp-controller="BaoHanh" asp-action="Index">Tra cứu bảo hành</a>
        </nav>
        <div class="admin-user mt-auto">
            <div class="small mb-2">
                <i class="bi bi-person-badge"></i> @User.FindFirst("HoTen")?.Value
                <div class="opacity-75">@VaiTro.TenHienThi(laAdmin ? VaiTro.Admin : VaiTro.NhanVien)</div>
            </div>
            <div class="d-flex gap-2">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-sm btn-outline-light flex-fill" target="_blank">Xem cửa hàng</a>
                <form asp-area="" asp-controller="TaiKhoan" asp-action="DangXuat" method="post" class="m-0 flex-fill">
                    <button class="btn btn-sm btn-outline-light w-100" type="submit">Đăng xuất</button>
                </form>
            </div>
        </div>
    </aside>

    <main class="flex-grow-1 admin-main">
        <div class="admin-mobilebar d-lg-none">
            <button class="btn btn-sm btn-outline-light" type="button" data-bs-toggle="offcanvas" data-bs-target="#adminMenu" aria-label="Mở menu"><i class="bi bi-list"></i></button>
            <span class="fw-bold">QUẢN TRỊ</span>
        </div>
        <div class="p-3 p-md-4">
            <partial name="_ThongBao" />
            @RenderBody()
        </div>
    </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
