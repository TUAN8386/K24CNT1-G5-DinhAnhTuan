@model PagedResult<TaiKhoan>
@{
    ViewData["Title"] = "Tài khoản";
    string? vt = ViewBag.VaiTro;
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h4 mb-0">Tài khoản</h1>
    <a asp-action="Create" class="btn btn-accent"><i class="bi bi-person-plus"></i> Thêm tài khoản</a>
</div>
<form method="get" class="row g-2 mb-3" style="max-width:640px">
    <div class="col-sm-6"><input name="q" value="@ViewBag.Q" class="form-control" placeholder="Tên đăng nhập, họ tên, SĐT" aria-label="Tìm" /></div>
    <div class="col-sm-4">
        <select name="vaiTro" class="form-select" aria-label="Vai trò">
            <option value="">Tất cả vai trò</option>
            @foreach (var v in VaiTro.TatCa) { <option value="@v" selected="@(vt == v)">@VaiTro.TenHienThi(v)</option> }
        </select>
    </div>
    <div class="col-sm-2"><button class="btn btn-outline-secondary w-100" type="submit">Lọc</button></div>
</form>
<div class="table-responsive">
    <table class="table table-hover align-middle table-admin">
        <thead class="table-light"><tr><th>Tên đăng nhập</th><th>Họ tên</th><th>SĐT</th><th>Email</th><th>Vai trò</th><th>Trạng thái</th><th class="text-end">Thao tác</th></tr></thead>
        <tbody>
        @foreach (var t in Model.Items)
        {
            <tr>
                <td class="fw-semibold">@t.TenDangNhap</td>
                <td>@t.HoTen</td>
                <td>@t.SoDienThoai</td>
                <td class="small">@t.Email</td>
                <td><span class="badge @(t.VaiTro == VaiTro.Admin ? "text-bg-dark" : t.VaiTro == VaiTro.NhanVien ? "text-bg-info" : "text-bg-light")">@VaiTro.TenHienThi(t.VaiTro)</span></td>
                <td>@if (t.BiKhoa) { <span class="badge text-bg-danger">Đã khóa</span> } else { <span class="badge text-bg-success">Hoạt động</span> }</td>
                <td class="text-end text-nowrap">
                    <form asp-action="DoiKhoa" asp-route-id="@t.MaTK" method="post" class="d-inline" data-confirm="@(t.BiKhoa ? "Mở khóa" : "Khóa") tài khoản @(t.TenDangNhap)?">
                        <button class="btn btn-sm btn-outline-warning" type="submit" title="@(t.BiKhoa ? "Mở khóa" : "Khóa")"><i class="bi @(t.BiKhoa ? "bi-unlock" : "bi-lock")"></i></button>
                    </form>
                    <a asp-action="Details" asp-route-id="@t.MaTK" class="btn btn-sm btn-outline-secondary" title="Chi tiết"><i class="bi bi-eye"></i></a>
                    <a asp-action="Edit" asp-route-id="@t.MaTK" class="btn btn-sm btn-outline-primary" title="Sửa"><i class="bi bi-pencil"></i></a>
                    <a asp-action="Delete" asp-route-id="@t.MaTK" class="btn btn-sm btn-outline-danger" title="Xóa"><i class="bi bi-trash"></i></a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
<partial name="_Pager" model="Model" />
