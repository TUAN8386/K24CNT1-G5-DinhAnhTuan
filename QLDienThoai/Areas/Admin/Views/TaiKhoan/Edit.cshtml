@model TaiKhoanFormVM
@{
    ViewData["Title"] = "Sửa tài khoản";
}
<h1 class="h4 mb-3">Sửa tài khoản: @Model.TenDangNhap</h1>
<form asp-action="Edit" asp-route-id="@Model.MaTK" method="post" class="box" style="max-width:760px">
    <partial name="_Form" model="Model" />
    <div class="mt-3">
        <button class="btn btn-accent" type="submit">Lưu thay đổi</button>
        <a asp-action="Index" class="btn btn-link">Quay lại</a>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
