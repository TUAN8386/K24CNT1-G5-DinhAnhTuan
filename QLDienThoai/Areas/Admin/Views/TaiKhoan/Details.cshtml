@model TaiKhoan
@{
    ViewData["Title"] = Model.TenDangNhap;
}
<h1 class="h4 mb-3">Tài khoản: @Model.TenDangNhap</h1>
<div class="box mb-3" style="max-width:700px">
    <dl class="row mb-0">
        <dt class="col-sm-4">Họ tên</dt><dd class="col-sm-8">@Model.HoTen</dd>
        <dt class="col-sm-4">Số điện thoại</dt><dd class="col-sm-8">@Model.SoDienThoai</dd>
        <dt class="col-sm-4">Email</dt><dd class="col-sm-8">@Model.Email</dd>
        <dt class="col-sm-4">Vai trò</dt><dd class="col-sm-8">@VaiTro.TenHienThi(Model.VaiTro)</dd>
        <dt class="col-sm-4">Trạng thái</dt><dd class="col-sm-8">@(Model.BiKhoa ? "Đã khóa" : "Hoạt động")</dd>
        <dt class="col-sm-4">Ngày tạo</dt><dd class="col-sm-8">@Model.NgayTao.ToString("dd/MM/yyyy")</dd>
        <dt class="col-sm-4">Số đơn hàng</dt><dd class="col-sm-8">@Model.DonHangs.Count (tổng @Model.DonHangs.Where(d => d.TrangThai == TrangThaiDon.HoanThanh).Sum(d => d.TongTien).ToString("N0") ₫ đã hoàn thành)</dd>
    </dl>
</div>
<a asp-action="Edit" asp-route-id="@Model.MaTK" class="btn btn-outline-primary">Sửa</a>
<a asp-controller="DonHang" asp-action="Index" asp-route-q="@Model.TenDangNhap" class="btn btn-outline-secondary">Xem đơn hàng</a>
<a asp-action="Index" class="btn btn-link">Quay lại</a>
