@inject GioHangService GioHang
@inject SoSanhService SoSanh
@{
    var soTrongGio = GioHang.DemSoLuong();
    var soSoSanh = SoSanh.LayDanhSach().Count;
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PhoneHub</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
<header class="site-header sticky-top">
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand fw-bold me-lg-4" asp-controller="Home" asp-action="Index">PhoneHub</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-label="Menu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link @(controller == "SanPham" ? "active" : "")" asp-controller="SanPham" asp-action="Index">Điện thoại</a></li>
                    <li class="nav-item"><a class="nav-link @(controller == "KhuyenMai" ? "active" : "")" asp-controller="KhuyenMai" asp-action="Index">Khuyến mãi</a></li>
                    <li class="nav-item"><a class="nav-link @(controller == "SoSanh" ? "active" : "")" asp-controller="SoSanh" asp-action="Index">So sánh (@soSoSanh)</a></li>
                    <li class="nav-item"><a class="nav-link @(controller == "BaoHanh" ? "active" : "")" asp-controller="BaoHanh" asp-action="Index">Tra cứu bảo hành</a></li>
                </ul>
                <form class="d-flex my-2 my-lg-0 me-lg-2 search-box" method="get" asp-controller="SanPham" asp-action="Index" role="search">
                    <input class="form-control" type="search" name="q" placeholder="Tìm tên máy..." value="@Context.Request.Query["q"]" aria-label="Tìm tên máy" />
                </form>
                <ul class="navbar-nav align-items-lg-center gap-lg-2">
                    <li class="nav-item my-1 my-lg-0">
                        <a class="btn btn-warning fw-semibold px-3" asp-controller="GioHang" asp-action="Index" title="Giỏ hàng">Giỏ (@soTrongGio)</a>
                    </li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle"></i> @User.FindFirst("HoTen")?.Value
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                @if (User.IsInRole(VaiTro.KhachHang))
                                {
                                    <li><a class="dropdown-item" asp-controller="DonHang" asp-action="LichSu"><i class="bi bi-receipt"></i> Đơn hàng của tôi</a></li>
                                }
                                else
                                {
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2"></i> Trang quản trị</a></li>
                                }
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form asp-controller="TaiKhoan" asp-action="DangXuat" method="post">
                                        <button class="dropdown-item" type="submit"><i class="bi bi-box-arrow-right"></i> Đăng xuất</button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item my-1 my-lg-0"><a class="btn btn-light px-3" asp-controller="TaiKhoan" asp-action="DangNhap">Đăng nhập</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>

<main class="container py-4">
    <partial name="_ThongBao" />
    @RenderBody()
</main>

<footer class="site-footer mt-5">
    <div class="container py-4">
        <div class="row g-4">
            <div class="col-md-5">
                <h5 class="fw-bold"><i class="bi bi-phone-vibrate"></i> PhoneHub</h5>
                <p class="mb-1">Điện thoại chính hãng Apple, Samsung, Xiaomi, OPPO, vivo.</p>
                <p class="mb-0 small">Bảo hành 12 tháng – tra cứu bằng IMEI.</p>
            </div>
            <div class="col-6 col-md-3">
                <h6 class="fw-bold">Mua sắm</h6>
                <ul class="list-unstyled small mb-0">
                    <li><a asp-controller="SanPham" asp-action="Index">Tất cả điện thoại</a></li>
                    <li><a asp-controller="KhuyenMai" asp-action="Index">Khuyến mãi</a></li>
                    <li><a asp-controller="SoSanh" asp-action="Index">So sánh máy</a></li>
                </ul>
            </div>
            <div class="col-6 col-md-4">
                <h6 class="fw-bold">Hỗ trợ</h6>
                <ul class="list-unstyled small mb-0">
                    <li><a asp-controller="BaoHanh" asp-action="Index">Tra cứu bảo hành IMEI</a></li>
                    <li>Hotline: 1800 0000</li>
                </ul>
            </div>
        </div>
        <div class="small text-center mt-4 opacity-75">&copy; @DateTime.Now.Year QLDienThoai – Website bán điện thoại di động</div>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
