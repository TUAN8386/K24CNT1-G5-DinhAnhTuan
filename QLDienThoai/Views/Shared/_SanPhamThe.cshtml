@model SanPhamTheVM
@{
    var vn = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
}
<div class="card product-card h-100">
    <a asp-controller="SanPham" asp-action="ChiTiet" asp-route-id="@Model.MaSP" class="product-img-wrap">
        <img src="@(Model.AnhDaiDien ?? "/images/no-phone.svg")" alt="@Model.TenSP" class="product-img" loading="lazy" />
        @if (!Model.ConHang) { <span class="badge bg-secondary position-absolute top-0 start-0 m-2">Hết hàng</span> }
    </a>
    <div class="card-body d-flex flex-column">
        <a asp-controller="SanPham" asp-action="ChiTiet" asp-route-id="@Model.MaSP" class="product-name">@Model.TenSP</a>
        <div class="price mt-1">@(Model.GiaThapNhat > 0 ? "Từ " + Model.GiaThapNhat.ToString("#,##0", vn) + "đ" : "Liên hệ")</div>
        <div class="rating-text small mb-2">
            @if (Model.SoDanhGia > 0)
            {
                @:Đánh giá @Model.DiemTrungBinh.ToString("0.0", vn)/5 (@Model.SoDanhGia)
            }
            else { <span class="text-muted">Chưa có đánh giá</span> }
        </div>
        <div class="d-flex gap-2 mt-auto">
            <a asp-controller="SanPham" asp-action="ChiTiet" asp-route-id="@Model.MaSP" class="btn btn-primary btn-sm flex-fill">Xem chi tiết</a>
            <form asp-controller="SoSanh" asp-action="Them" method="post" class="flex-fill">
                <input type="hidden" name="id" value="@Model.MaSP" />
                <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                <button type="submit" class="btn btn-outline-secondary btn-sm w-100">+ So sánh</button>
            </form>
        </div>
    </div>
</div>
