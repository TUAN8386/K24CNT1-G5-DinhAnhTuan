@model ChiTietSanPhamVM
@{
    var sp = Model.SanPham;
    ViewData["Title"] = sp.TenSP;
    var chon = Model.PhienBans.FirstOrDefault(p => p.SoLuongTon > 0) ?? Model.PhienBans.FirstOrDefault();
    var url = Context.Request.Path.ToString();
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
        <li class="breadcrumb-item"><a asp-action="Index" asp-route-hang="@sp.MaHang">@sp.HangSanXuat?.TenHang</a></li>
        <li class="breadcrumb-item active">@sp.TenSP</li>
    </ol>
</nav>

<div class="row g-4">
    <div class="col-md-5">
        @{
            var dsAnh = new List<string>();
            if (!string.IsNullOrEmpty(sp.AnhDaiDien)) dsAnh.Add(sp.AnhDaiDien);
            dsAnh.AddRange(sp.HinhAnhs.OrderBy(h => h.ThuTu).Select(h => h.DuongDan));
        }
        <div class="box text-center">
            <img id="anhChinh" src="@(dsAnh.FirstOrDefault() ?? "/images/no-phone.svg")" alt="@sp.TenSP" class="img-fluid" style="max-height:420px;width:100%;object-fit:contain" />
            @if (dsAnh.Count > 1)
            {
                <div class="gallery-thumbs mt-3" role="list">
                    @for (var i = 0; i < dsAnh.Count; i++)
                    {
                        <button type="button" class="gallery-thumb @(i == 0 ? "active" : "")" data-anh="@dsAnh[i]" aria-label="Xem ảnh @(i + 1)">
                            <img src="@dsAnh[i]" alt="" loading="lazy" />
                        </button>
                    }
                </div>
            }
        </div>
    </div>
    <div class="col-md-7">
        <h1 class="h3 fw-bold">@sp.TenSP</h1>
        <div class="mb-2 text-warning">
            @for (var i = 1; i <= 5; i++) { <i class="bi @(i <= Math.Round(Model.DiemTrungBinh) ? "bi-star-fill" : "bi-star")"></i> }
            <span class="text-muted small">(@Model.DanhGias.Count đánh giá)</span>
        </div>

        @if (chon == null)
        {
            <div class="alert alert-secondary">Sản phẩm đang cập nhật phiên bản.</div>
        }
        else
        {
            <div class="price fs-3 mb-3" id="giaHienThi">@chon.GiaBan.ToString("N0") ₫</div>

            <form asp-controller="GioHang" asp-action="Them" method="post" class="box">
                <input type="hidden" name="returnUrl" value="@url" />
                <div class="fw-semibold mb-2">Chọn phiên bản (dung lượng – màu)</div>
                <div class="d-flex flex-wrap gap-2 mb-3">
                    @foreach (var pb in Model.PhienBans)
                    {
                        <div class="version-option">
                            <input type="radio" name="maPB" id="pb@(pb.MaPB)" value="@pb.MaPB" data-gia="@pb.GiaBan.ToString("0")"
                                   checked="@(pb.MaPB == chon.MaPB)" disabled="@(pb.SoLuongTon == 0)" />
                            <label for="pb@(pb.MaPB)">
                                <strong>@pb.DungLuong</strong> · @pb.MauSac<br />
                                <span class="small">@pb.GiaBan.ToString("N0") ₫</span>
                                <span class="small @(pb.SoLuongTon == 0 ? "text-danger" : "text-success")">
                                    · @(pb.SoLuongTon == 0 ? "Hết hàng" : $"Còn {pb.SoLuongTon}")
                                </span>
                            </label>
                        </div>
                    }
                </div>
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <label for="soLuong" class="small">Số lượng</label>
                    <input id="soLuong" type="number" name="soLuong" value="1" min="1" max="10" class="form-control" style="width:90px" />
                    <button type="submit" class="btn btn-outline-primary"><i class="bi bi-bag-plus"></i> Thêm vào giỏ</button>
                    <button type="submit" name="muaNgay" value="true" class="btn btn-accent"><i class="bi bi-lightning-charge"></i> Mua ngay</button>
                </div>
            </form>

            <div class="box mt-3" data-tragop data-gia="@chon.GiaBan.ToString("0")" data-lai="@Model.LaiSuatThang.ToString(System.Globalization.CultureInfo.InvariantCulture)" id="traGopBox">
                <div class="fw-semibold mb-2"><i class="bi bi-calculator"></i> Tính trả góp
                    <span class="badge bg-success">@(Model.LaiSuatThang == 0 ? "Lãi 0%" : $"Lãi {Model.LaiSuatThang}%/tháng")</span>
                </div>
                <div class="row g-2 align-items-end">
                    <div class="col-6 col-md-3">
                        <label class="form-label small" for="tgPt">Trả trước</label>
                        <select id="tgPt" class="form-select form-select-sm" data-tg="phantram">
                            @foreach (var p in new[] { 10, 20, 30, 40, 50, 70 }) { <option value="@p" selected="@(p == 30)">@p%</option> }
                        </select>
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label small" for="tgKy">Kỳ hạn</label>
                        <select id="tgKy" class="form-select form-select-sm" data-tg="kyhan">
                            <option value="6">6 tháng</option><option value="9">9 tháng</option><option value="12">12 tháng</option>
                        </select>
                    </div>
                    <div class="col-md-6 small">
                        Trả trước: <strong data-tg="tratruoc"></strong><br />
                        Góp mỗi tháng: <strong class="text-danger" data-tg="gop"></strong><br />
                        Tổng phải trả: <strong data-tg="tong"></strong>
                    </div>
                </div>
            </div>
        }

        <form asp-controller="SoSanh" asp-action="Them" method="post" class="mt-3">
            <input type="hidden" name="id" value="@sp.MaSP" />
            <input type="hidden" name="returnUrl" value="@url" />
            <button class="btn btn-outline-secondary btn-sm" type="submit"><i class="bi bi-layout-three-columns"></i> Thêm vào so sánh</button>
        </form>
    </div>
</div>

<div class="row g-4 mt-1">
    <div class="col-lg-5">
        <h2 class="section-title">Thông số kỹ thuật</h2>
        <table class="table table-bordered bg-white spec-table">
            <tr><th>Hãng</th><td>@sp.HangSanXuat?.TenHang</td></tr>
            <tr><th>Màn hình</th><td>@sp.ManHinh</td></tr>
            <tr><th>Chip</th><td>@sp.Chip</td></tr>
            <tr><th>Camera</th><td>@sp.Camera</td></tr>
            <tr><th>Pin</th><td>@sp.Pin</td></tr>
            <tr><th>Hệ điều hành</th><td>@sp.HeDieuHanh</td></tr>
        </table>
    </div>
    <div class="col-lg-7">
        <h2 class="section-title">Mô tả chi tiết</h2>
        @* MoTa đã được lọc XSS bằng HtmlSanitizer khi lưu *@
        <div class="box review-content">@Html.Raw(sp.MoTa)</div>
    </div>
</div>

<h2 class="section-title" id="danh-gia">Đánh giá sản phẩm</h2>
<div class="row g-4">
    <div class="col-lg-7">
        @if (!Model.DanhGias.Any())
        {
            <p class="text-muted">Chưa có đánh giá nào.</p>
        }
        @foreach (var dg in Model.DanhGias)
        {
            <div class="box mb-2">
                <div class="d-flex justify-content-between">
                    <strong>@dg.TaiKhoan?.HoTen</strong>
                    <span class="small text-muted">@dg.NgayDanhGia.ToString("dd/MM/yyyy")</span>
                </div>
                <div class="text-warning small mb-1">
                    @for (var i = 1; i <= 5; i++) { <i class="bi @(i <= dg.Diem ? "bi-star-fill" : "bi-star")"></i> }
                </div>
                <div class="review-content">@Html.Raw(dg.NoiDung)</div>
            </div>
        }
    </div>
    <div class="col-lg-5">
        @if (Model.DuocDanhGia)
        {
            <form asp-controller="DanhGia" asp-action="Them" method="post" class="box">
                <input type="hidden" name="MaSP" value="@sp.MaSP" />
                <div class="fw-semibold mb-1">Viết đánh giá của bạn</div>
                <div class="rating-input mb-2">
                    @for (var i = 5; i >= 1; i--)
                    {
                        <input type="radio" name="Diem" id="sao@(i)" value="@i" required />
                        <label for="sao@(i)" title="@i sao"><i class="bi bi-star-fill"></i></label>
                    }
                </div>
                <textarea name="NoiDung" class="rich-editor"></textarea>
                <button class="btn btn-accent mt-2" type="submit">Gửi đánh giá</button>
            </form>
        }
        else if (User.Identity?.IsAuthenticated != true)
        {
            <div class="box small text-muted"><a asp-controller="TaiKhoan" asp-action="DangNhap" asp-route-returnUrl="@url">Đăng nhập</a> để đánh giá sản phẩm bạn đã mua.</div>
        }
        else
        {
            <div class="box small text-muted">Bạn có thể đánh giá sau khi đơn hàng chứa sản phẩm này hoàn thành (mỗi sản phẩm đánh giá một lần).</div>
        }
    </div>
</div>

@if (Model.DaXem.Any())
{
    <h2 class="section-title">Bạn đã xem</h2>
    <div class="row row-cols-2 row-cols-md-4 g-3">
        @foreach (var x in Model.DaXem) { <div class="col"><partial name="_SanPhamThe" model="x" /></div> }
    </div>
}

@section Scripts {
    @if (Model.DuocDanhGia) { <partial name="_EditorScripts" /> }
    <script>
        // Đổi phiên bản -> cập nhật giá hiển thị và máy tính trả góp
        document.querySelectorAll('input[name="maPB"]').forEach(function (r) {
            r.addEventListener('change', function () {
                var gia = parseFloat(r.getAttribute('data-gia'));
                document.getElementById('giaHienThi').textContent = formatVnd(gia);
                var box = document.getElementById('traGopBox');
                box.setAttribute('data-gia', gia);
                tinhTraGop(box);
            });
        });
    </script>
}
