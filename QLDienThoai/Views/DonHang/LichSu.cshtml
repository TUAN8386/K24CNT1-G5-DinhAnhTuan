@model PagedResult<DonHang>
@{
    ViewData["Title"] = "Đơn hàng của tôi";
}
<h1 class="h4 mb-3"><i class="bi bi-receipt"></i> Đơn hàng của tôi</h1>

@if (!Model.Items.Any())
{
    <div class="box text-center py-5 text-muted">Bạn chưa có đơn hàng nào.</div>
}
else
{
    <div class="box p-0">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light"><tr><th>Mã đơn</th><th>Ngày đặt</th><th class="text-end">Tổng tiền</th><th>Thanh toán</th><th>Trạng thái</th><th></th></tr></thead>
                <tbody>
                    @foreach (var d in Model.Items)
                    {
                        <tr>
                            <td>#@d.MaDH</td>
                            <td>@d.NgayDat.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-end">@d.TongTien.ToString("N0") ₫</td>
                            <td>@d.PhuongThucTT @if (d.DaThanhToan) { <i class="bi bi-check-circle text-success" title="Đã thanh toán"></i> }</td>
                            <td><span class="badge text-bg-@TrangThaiDon.MauBadge(d.TrangThai)">@d.TrangThai</span></td>
                            <td><a asp-action="ChiTiet" asp-route-id="@d.MaDH" class="btn btn-sm btn-outline-primary">Chi tiết</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <partial name="_Pager" model="Model" />
}
